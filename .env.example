# For more information, please see the README.md
SUNO_COOKIE=
TWOCAPTCHA_KEY= # Obtain from 2captcha.com

# Suno `mv` model identifier. Leave blank to use the fork default (chirp-fenix / v5.5).
# See DEFAULT_MODEL in src/lib/SunoApi.ts for the full codename list.
SUNO_MODEL=

BROWSER=chromium # `chromium` or `firefox`, although `chromium` is highly recommended
BROWSER_GHOST_CURSOR=false
BROWSER_LOCALE=en
BROWSER_HEADLESS=true

# CAPTCHA strategy:
#   unset / false → automatic only (requires TWOCAPTCHA_KEY; may break on UI redesigns)
#   true          → manual only (skip auto, open a visible browser for the human to solve)
#   fallback      → try automatic first, fall back to manual on error (recommended for local use)
MANUAL_CAPTCHA=

# CAPTCHA timeouts. Three separate knobs, because they answer three questions.
# These were once one variable, and the overload was a trap: CAPTCHA_WAIT_MAX_S=0
# meant "escalate immediately" but ALSO silently capped the automatic flow at 60s.
#
#   CAPTCHA_WAIT_MAX_S   seconds to idle-poll for Suno's wall to drop before
#                        escalating to a solver or a human. 0 = escalate now.
#   CAPTCHA_FLOW_MAX_S   hard cap on the AUTOMATIC flow, end to end.
#   CAPTCHA_MANUAL_MAX_S hard cap on the MANUAL flow. Generous — it waits on a
#                        person — but never absent, or a browser that dies
#                        without emitting `close` wedges the request forever.
CAPTCHA_WAIT_MAX_S=600
CAPTCHA_FLOW_MAX_S=600
CAPTCHA_MANUAL_MAX_S=900